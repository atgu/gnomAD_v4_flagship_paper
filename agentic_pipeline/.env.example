# Copy to `.env` in this directory and fill in. NEVER commit `.env`.
#
# Only stage 1 (the LLM agents) needs any of this. Stages 2 to 5, which
# regenerate DisPo, OMELET and the figures from the frozen agent outputs,
# run with no credentials at all.

# ---------------------------------------------------------------------------
# LLM provider — Vertex AI (default)
# ---------------------------------------------------------------------------
# Claude is reached through Vertex by suffixing the model id with "@vertex"
# (e.g. claude-haiku-4-5@vertex), which bills GCP credits instead of the
# Anthropic API. Vertex authenticates with Application Default Credentials,
# so there is no key to put here. Authenticate once with:
#
#     gcloud auth application-default login
#
GOOGLE_CLOUD_PROJECT=guez-sandbox-aedc
ANTHROPIC_VERTEX_REGION=global
VERTEX_LOCATION=us-central1

# ---------------------------------------------------------------------------
# LLM provider — direct Anthropic API (optional)
# ---------------------------------------------------------------------------
# Required only for model ids WITHOUT the "@vertex" suffix. The published
# run_016 used this route; reproductions use Vertex. Leave empty otherwise.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# NCBI E-utilities
# ---------------------------------------------------------------------------
# Optional but strongly recommended: raises the PubMed rate limit from 3 to
# 10 requests/s. Without it the agents still run, just slower.
# Request one at https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Contact address sent with every E-utilities call, per NCBI usage policy.
NCBI_EMAIL=

# ---------------------------------------------------------------------------
# Location of the frozen agent outputs
# ---------------------------------------------------------------------------
# The 21,955 per-gene JSON files of run_016 (4.4 GB) are far too large to ship
# in this repository. Point this at a local copy, or fetch the archive first:
#
#     gcloud storage cp \
#       gs://llm_agents_bucket/archives/run_016/run_016_results.tar.zst .
#     tar -I 'zstd -d --long=27' -xf run_016_results.tar.zst
#
PEPPER_RUN_016_RESULTS=
